# ============================================================
# 生产环境配置（服务器上的 .env.prod）
#
# 用法：
#   cp .env.prod.example .env.prod
#   编辑 .env.prod 填好密码与 LLM Key
#   bash deploy/deploy.sh
#
# 注意：这个文件**不要提交到仓库**（.gitignore 已排除 .env.prod）。
# 服务器上的密码不会经过 CI —— CI 只负责镜像，配置留在服务器本地。
# ============================================================

# ---------- 本平台的数据库 ----------
# 复用客服项目的 cs-postgres 实例，但使用独立角色与独立库，
# 这样两个项目改密码、建表都不会互相影响。
CS_SUPERUSER=cs
POSTGRES_USER=kb
POSTGRES_DB=kb
# 必填：部署脚本会据此创建/同步 kb 角色密码。请改成强随机值。
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ---------- 对外访问 ----------
# 只占这一个端口；客服项目用的是 80/443，互不影响。
# 需在服务器防火墙/安全组放行该端口。
HTTP_PORT=8080

# ---------- 鉴权 ----------
# 必填：生成方式 python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_random_48_byte_string
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
# 首次启动会用它创建管理员账号，登录后请立即修改
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# ---------- 大模型（OpenAI 兼容协议）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_OFFLINE_FALLBACK=true

# ---------- 向量化 ----------
# 留空 api_key 时使用内置本地哈希嵌入（离线可用，免 API Key 也能跑通全流程）。
# 若要接真实语义嵌入：填 key，并把 EMBEDDING_DIM 改成与模型一致，
# 然后**清空数据卷重新初始化**（建表时向量维度已固化）。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------- 检索与切片 ----------
CHUNK_SIZE=520
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=8
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_KEYWORD_WEIGHT=0.35
# 0 = 按嵌入模式自动取值（本地哈希嵌入 0.14 / 远程语义嵌入 0.30）
CONFIDENCE_THRESHOLD=0

# ---------- FAQ 沉淀 ----------
FAQ_CLUSTER_SIMILARITY=0
FAQ_CACHE_MATCH_THRESHOLD=0
FAQ_MIN_FREQUENCY=3
FAQ_CACHE_ENABLED=true
FAQ_CACHE_TTL_SECONDS=300

# ---------- 上传 ----------
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.pdf,.md,.markdown,.docx,.txt

# ---------- 镜像 ----------
# 由部署脚本按 commit 覆写，无需手工修改
IMAGE_TAG=latest
REGISTRY=ghcr.io
