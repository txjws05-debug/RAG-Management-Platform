# ===== 数据库（PostgreSQL 16 + pgvector）=====
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_pass
POSTGRES_DB=kb

# ===== 服务入口 =====
# 浏览器访问 http://localhost:${HTTP_PORT}
HTTP_PORT=8080
NEXT_PUBLIC_API_BASE=/api

# ===== 鉴权 =====
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-0123456789abcdefghijklmnop
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 首次启动自动建管理员账号
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456

# ===== AI：OpenAI 兼容协议，base_url 可自由切换 =====
# 支持 OpenAI / DeepSeek / 通义 / vLLM / Ollama 等任意兼容端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
# 无 key 时自动降级为本地确定性摘要答案，便于离线跑通演示链路
LLM_OFFLINE_FALLBACK=true

# ===== 向量化（Embedding）=====
# 同样走 OpenAI 兼容协议；留空 api_key 时使用内置本地哈希嵌入（离线可用）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== 检索与切片 =====
CHUNK_SIZE=520
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=8
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_KEYWORD_WEIGHT=0.35
# 置信度阈值：0 = 按嵌入模式自动取值（本地哈希嵌入 0.14 / 远程语义嵌入 0.30）
# 低于该相似度的提问视为「未命中」→ 自动计入知识缺口
CONFIDENCE_THRESHOLD=0

# ===== FAQ 沉淀 =====
# 注意：本地哈希嵌入的余弦分布比真实语义模型紧凑得多，阈值必须分模式设定，
# 否则「聚类不出高频问题」和「缓存永不命中」会同时发生。
# 0 = 按嵌入模式自动取值（本地 0.45 / 远程 0.86）
FAQ_CLUSTER_SIMILARITY=0
# 缓存命中阈值：0 = 按嵌入模式自动取值（本地 0.55 / 远程 0.92）
# 实际匹配分 = max(余弦, 0.55*余弦 + 0.45*词面重叠系数)，词面信号可显著提升同义改写召回
FAQ_CACHE_MATCH_THRESHOLD=0
FAQ_MIN_FREQUENCY=3
FAQ_CACHE_ENABLED=true
FAQ_CACHE_TTL_SECONDS=300

# ===== 上传 =====
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.pdf,.md,.markdown,.docx,.txt
